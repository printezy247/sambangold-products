# Sambangold — 18 products, Telegram bot + dashboard
# Copy this file and fill in your keys.

TELEGRAM_BOT_TOKEN=
FLASK_SECRET_KEY=
PUBLIC_BASE_URL=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
USDT_ADDRESS=
ADMIN_TELEGRAM_ID=
DATABASE_PATH=data/sambangold.db
TASK_TOKEN=
TELEGRAM_BOT_USERNAME=
PUBLIC_CHANNEL_URL=

# Internal team bot — a second, separate Telegram bot for Sam's CEO/HODs/
# Executives only. Create it via @BotFather, then `flask team-set-webhook`.
TEAM_BOT_TOKEN=
TEAM_BOT_USERNAME=
TEAM_GROUP_CHAT_ID=

# Optional AI layer on /team/chat (OpenAI-compatible chat-completions API).
# Local file search works without these; set all three to turn it on.
NARA_API_KEY=
NARA_BASE_URL=
NARA_MODEL=

# Email sign-in codes go out over plain SMTP. Any free relay works: a Gmail app
# password (smtp.gmail.com:587), Brevo's free tier, or a local relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional
EZYAI_SITE_URL=https://printezy.money
EZYAI_SITE_KEY=
SENTRY_DSN=
EZYAI_DEMO_DATA=false
